# Copy this file to .env

# Default: SQLite file (no setup needed)
DATABASE_URL=sqlite:///app.db

# Optional: PostgreSQL (use with docker-compose.yml at the project root)
# DATABASE_URL=postgresql://appuser:apppassword@localhost:5432/appdb

# Origin(s) allowed to call the API directly (Vite dev server)
CORS_ORIGINS=http://localhost:5173
