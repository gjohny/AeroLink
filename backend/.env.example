# Copy to backend/.env for local development and set a random SECRET_KEY.
SECRET_KEY=
DATABASE_URL=sqlite:///app.db
CORS_ORIGINS=http://localhost:5173
# AirLabs API key for live flight data. Put your own key in backend/.env, never in this file
AIRLABS_API_KEY=
# Live flight data is off unless this is "on". When off, the app uses flights saved in the database (test data),
# so nothing uses the AirLabs allowance. Applies to flight searches, Look up, and the live check script
LIVE_FLIGHT_DATA=off
# 5 min cached upstream responses; delay alert at 20+ minutes
FLIGHT_CACHE_TTL_SECONDS=300
FLIGHT_DELAY_THRESHOLD_MINUTES=20
