# Generate a secret for manual startup; node start.js generates one if absent.
# SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=sqlite:///app.db
CORS_ORIGINS=http://localhost:5173
WEATHER_FORECAST_URL=https://api.open-meteo.com
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com
WEATHER_ROUTING_URL=https://router.project-osrm.org
# WEATHER_MODEL_MANIFEST=/absolute/path/to/validated-model.json

# Optional destination cover photos; trips work without this key.
# UNSPLASH_ACCESS_KEY=your-access-key
